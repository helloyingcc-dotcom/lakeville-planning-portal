{
  // Cloudflare deploys this automatically on every push to main (Workers Builds).
  "name": "lakeville-planning",
  "main": "worker.js",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "preview_urls": false,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "lakeville-planning",
      "database_id": "a3d9a49a-e440-4cab-9ddf-07fd4b49898f"
    }
  ],
  // File storage for answer files and comment attachments.
  "r2_buckets": [{ "binding": "BUCKET", "bucket_name": "lakeville-planning-files" }],
  "vars": {
    // From Worker → Settings → Domains & Routes → workers.dev → Enable Cloudflare Access (shown in the pop-up).
    "ACCESS_TEAM_DOMAIN": "calm-art-0c96.cloudflareaccess.com",
    "OWNER_EMAILS": "yingaz@gmail.com",
    "ACCESS_AUD": "37fc497fa3e217e669dcfe3c19091911ae17bdae35d958bca77b11b1e3c745ef"
  },
  // Every 2 minutes: email DBY a grouped alert about new Lakeville activity (needs RESEND_API_KEY).
  "triggers": { "crons": ["*/2 * * * *"] },
  "observability": { "enabled": true }
}
